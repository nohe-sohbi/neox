# ──────────────────────────────────────────────────────────────
# NEOX environment configuration
# ──────────────────────────────────────────────────────────────

# TMDB API (required). Free key: https://www.themoviedb.org/settings/api
# Use EITHER the v3 API key...
TMDB_API_KEY=your_tmdb_v3_api_key_here
# ...or a v4 read access token (optional, takes precedence for auth header):
# TMDB_READ_TOKEN=your_tmdb_v4_read_access_token

# Localization for results & "where to watch" availability.
TMDB_REGION=FR
TMDB_LANGUAGE=fr-FR

# Backend port (optional, defaults to 3001).
# PORT=3001

# Secret used to sign auth tokens (JWT). REQUIRED: the API refuses to boot in
# production without it, and `docker compose up` refuses to start. Deliberately
# left empty: a shared placeholder would be as good as no secret at all.
# Generate your own with: openssl rand -hex 32
JWT_SECRET=

# ── Frontend (baked into the bundle at BUILD time) ────────────
# Public origin of the deployed app. Drives canonical + Open Graph URLs, and
# rewrites robots.txt / sitemap.xml during `npm run build`.
# VITE_SITE_URL=https://neox.example.com

# Host port for the web container (defaults to 8080).
# WEB_PORT=8080

# Optional: analytics via a self-hosted Umami instance. No script is loaded
# when the id is unset. VITE_UMAMI_DOMAINS keeps localhost out of the stats.
# VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# VITE_UMAMI_DOMAINS=neox.example.com
# VITE_UMAMI_SRC=https://analytics.example.com/script.js
