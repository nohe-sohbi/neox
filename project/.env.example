# Base URL of the NEOX API (backend).
# Local dev: http://localhost:3001  |  Docker network: http://backend:3001
VITE_API_URL=http://localhost:3001

# Optional — privacy-friendly analytics via Plausible. Leave empty to disable
# (no script is loaded when unset).
# VITE_PLAUSIBLE_DOMAIN=neox.example.com
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
