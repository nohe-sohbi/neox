<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for NEOX's stable, indexable routes. Title/person deep links are
  client-rendered and effectively infinite, so they are intentionally left out;
  these are the durable entry points worth crawling.
-->
<urlset xmlns="http://www.sitemap.org/schemas/sitemap/0.9">
  <url>
    <loc>https://neox.app/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://neox.app/movies</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://neox.app/tv</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://neox.app/search</loc>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
